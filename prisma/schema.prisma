generator client {
  provider               = "prisma-client"
  output                 = "../agent/lib/database/generated"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

enum ReviewJobMode {
  INCREMENTAL
  RECONCILIATION
}

enum ReviewJobStatus {
  PENDING
  LEASED
  COMPLETED
  FAILED
}

enum ReviewLeaseOutcome {
  COMPLETED
  FAILED
  RECOVERED
}

enum RoadieScopeStatus {
  PENDING
  RESOLVED
  REPO_ONLY
}

enum ReviewTargetKind {
  REPOSITORY
  CONFLUENCE
}

enum ReviewJobOutcome {
  NO_CHANGE
  IN_SYNC
  PROPOSAL_CREATED
  INCOMPLETE
}

model RepositoryRegistry {
  id                     String            @id @default(uuid()) @db.Uuid
  githubRepositoryId     String            @unique @map("github_repository_id")
  repositoryFullName     String            @unique @map("repository_full_name")
  defaultBranch          String            @map("default_branch")
  defaultBranchHeadSha   String            @map("default_branch_head_sha")
  isAccessible           Boolean           @default(true) @map("is_accessible")
  isArchived             Boolean           @default(false) @map("is_archived")
  isPaused               Boolean           @default(false) @map("is_paused")
  roadieScopeStatus      RoadieScopeStatus @default(PENDING) @map("roadie_scope_status")
  componentRef           String?           @map("component_ref")
  systemRef              String?           @map("system_ref")
  ownerRef               String?           @map("owner_ref")
  slackChannelId         String?           @map("slack_channel_id")
  documentationScope     Json?             @map("documentation_scope")
  catalogRevision        String?           @map("catalog_revision")
  configurationHash      String?           @map("configuration_hash")
  roadieDiagnostics      Json              @default("[]") @map("roadie_diagnostics")
  lastRoadieRefreshAt    DateTime?         @map("last_roadie_refresh_at") @db.Timestamptz(3)
  nextReviewAt           DateTime?         @map("next_review_at") @db.Timestamptz(3)
  lastInventoryRefreshAt DateTime          @map("last_inventory_refresh_at") @db.Timestamptz(3)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  cursor                 RepositoryCursor?
  reviewJobs             ReviewJob[]
  evidenceClaims         EvidenceClaim[]
  changeProposals        ChangeProposal[]
  confluenceDraftArtifacts ConfluenceDraftArtifact[]
  auditEvents            AuditEvent[]

  @@index([isAccessible, isArchived, isPaused, nextReviewAt], map: "repository_registry_scheduling_eligibility_idx")
  @@index([roadieScopeStatus], map: "repository_registry_roadie_scope_status_idx")
  @@map("repository_registry")
}

model RepositoryCursor {
  repositoryId                String             @id @map("repository_id") @db.Uuid
  lastSuccessfullyReviewedSha String?            @map("last_successfully_reviewed_sha")
  lastSuccessfullyReviewedAt  DateTime?          @map("last_successfully_reviewed_at") @db.Timestamptz(3)
  createdAt                   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  repository                  RepositoryRegistry @relation(fields: [repositoryId], references: [id], onDelete: Restrict)

  @@map("repository_cursors")
}

model ReviewJobClaimInvocation {
  id              String      @id @db.Uuid
  workerId        String      @map("worker_id")
  requestedLimit  Int         @map("requested_limit")
  leaseDurationMs Int         @map("lease_duration_ms")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  reviewJobs      ReviewJob[]

  @@map("review_job_claim_invocations")
}

model ReviewJob {
  id                   String                         @id @default(uuid()) @db.Uuid
  repositoryId         String                         @map("repository_id") @db.Uuid
  claimInvocationId    String?                        @map("claim_invocation_id") @db.Uuid
  baseSha              String?                        @map("base_sha")
  headSha              String                         @map("head_sha")
  mode                 ReviewJobMode
  deduplicationKey     String                         @unique @map("deduplication_key")
  attemptNumber        Int                            @default(1) @map("attempt_number")
  status               ReviewJobStatus                @default(PENDING)
  attemptCount         Int                            @default(0) @map("attempt_count")
  availableAt          DateTime                       @default(now()) @map("available_at") @db.Timestamptz(3)
  leaseOwner           String?                        @map("lease_owner")
  leaseToken           String?                        @map("lease_token") @db.Uuid
  lastLeaseToken       String?                        @map("last_lease_token") @db.Uuid
  lastLeaseOutcome     ReviewLeaseOutcome?            @map("last_lease_outcome")
  leaseExpiresAt       DateTime?                      @map("lease_expires_at") @db.Timestamptz(3)
  completedAt          DateTime?                      @map("completed_at") @db.Timestamptz(3)
  failedAt             DateTime?                      @map("failed_at") @db.Timestamptz(3)
  lastFailureCode      String?                        @map("last_failure_code")
  lastFailureMessage   String?                        @map("last_failure_message")
  outcome              ReviewJobOutcome?
  outcomeSummary       String?                        @map("outcome_summary")
  cursorAdvancedAt     DateTime?                      @map("cursor_advanced_at") @db.Timestamptz(3)
  createdAt            DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                       @updatedAt @map("updated_at") @db.Timestamptz(3)
  repository           RepositoryRegistry             @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  claimInvocation      ReviewJobClaimInvocation?      @relation(fields: [claimInvocationId], references: [id], onDelete: Restrict)
  evidenceClaims       EvidenceClaim[]
  changeProposals      ChangeProposal[]
  confluenceCandidates ReviewJobConfluenceCandidate[]
  confluenceDraftArtifacts ConfluenceDraftArtifact[]
  auditEvents          AuditEvent[]

  @@index([status, availableAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([claimInvocationId, status])
  @@index([repositoryId, createdAt])
  @@index([repositoryId, baseSha, headSha, mode, attemptNumber], map: "review_jobs_repository_review_attempt_idx")
  @@map("review_jobs")
}

model ConfluencePageSnapshot {
  id               String                         @id @default(uuid()) @db.Uuid
  siteId           String                         @map("site_id")
  pageId           String                         @map("page_id")
  version          Int
  status           String
  title            String
  spaceId          String                         @map("space_id")
  parentId         String?                        @map("parent_id")
  bodyStorageValue String                         @map("body_storage_value")
  bodyHash         String                         @map("body_hash")
  fetchedAt        DateTime                       @map("fetched_at") @db.Timestamptz(3)
  candidates       ReviewJobConfluenceCandidate[]

  @@unique([siteId, pageId, version])
  @@index([siteId, pageId, fetchedAt])
  @@map("confluence_page_snapshots")
}

model ReviewJobConfluenceCandidate {
  id          String                  @id @default(uuid()) @db.Uuid
  reviewJobId String                  @map("review_job_id") @db.Uuid
  siteId      String                  @map("site_id")
  pageId      String                  @map("page_id")
  label       String
  snapshotId  String?                 @map("snapshot_id") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  reviewJob   ReviewJob               @relation(fields: [reviewJobId], references: [id], onDelete: Restrict)
  snapshot    ConfluencePageSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@unique([reviewJobId, siteId, pageId])
  @@index([reviewJobId, createdAt])
  @@index([snapshotId])
  @@map("review_job_confluence_candidates")
}

model EvidenceClaim {
  id                       String                   @id @default(uuid()) @db.Uuid
  repositoryId             String                   @map("repository_id") @db.Uuid
  reviewJobId              String                   @map("review_job_id") @db.Uuid
  digest                   String                   @unique
  claimText                String                   @map("claim_text")
  implementationSha        String                   @map("implementation_sha")
  implementationReferences Json                     @map("implementation_references")
  behaviorComparisons      Json                     @map("behavior_comparisons")
  targetKind               ReviewTargetKind         @map("target_kind")
  documentation            Json
  confidenceReasons        Json                     @map("confidence_reasons")
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  repository               RepositoryRegistry       @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  reviewJob                ReviewJob                @relation(fields: [reviewJobId], references: [id], onDelete: Restrict)
  proposalLinks            ChangeProposalEvidence[]

  @@index([reviewJobId, createdAt])
  @@index([repositoryId, createdAt])
  @@map("evidence_claims")
}

model ChangeProposal {
  id                    String                   @id @default(uuid()) @db.Uuid
  repositoryId          String                   @map("repository_id") @db.Uuid
  reviewJobId           String                   @map("review_job_id") @db.Uuid
  digest                String                   @unique
  targetKind            ReviewTargetKind         @map("target_kind")
  target                Json
  repositoryBaselineSha String?                  @map("repository_baseline_sha")
  patch                 Json
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  repository            RepositoryRegistry       @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  reviewJob             ReviewJob                @relation(fields: [reviewJobId], references: [id], onDelete: Restrict)
  evidenceLinks         ChangeProposalEvidence[]
  confluenceDraftArtifacts ConfluenceDraftArtifact[]

  @@index([reviewJobId, createdAt])
  @@index([repositoryId, createdAt])
  @@map("change_proposals")
}

model ChangeProposalEvidence {
  changeProposalId String         @map("change_proposal_id") @db.Uuid
  evidenceClaimId  String         @map("evidence_claim_id") @db.Uuid
  changeProposal   ChangeProposal @relation(fields: [changeProposalId], references: [id], onDelete: Restrict)
  evidenceClaim    EvidenceClaim  @relation(fields: [evidenceClaimId], references: [id], onDelete: Restrict)

  @@id([changeProposalId, evidenceClaimId])
  @@index([evidenceClaimId])
  @@map("change_proposal_evidence")
}

model ConfluenceDraftArtifact {
  id               String             @id @default(uuid()) @db.Uuid
  repositoryId     String             @map("repository_id") @db.Uuid
  reviewJobId      String             @map("review_job_id") @db.Uuid
  changeProposalId String             @map("change_proposal_id") @db.Uuid
  proposalDigest   String             @map("proposal_digest")
  siteId           String             @map("site_id")
  pageId           String             @map("page_id")
  baselineVersion  Int                @map("baseline_version")
  baselineBodyHash String             @map("baseline_body_hash")
  draftPageId      String             @map("draft_page_id")
  draftVersion     Int                @map("draft_version")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  repository       RepositoryRegistry @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  reviewJob        ReviewJob          @relation(fields: [reviewJobId], references: [id], onDelete: Restrict)
  changeProposal   ChangeProposal     @relation(fields: [changeProposalId], references: [id], onDelete: Restrict)

  @@index([changeProposalId])
  @@index([proposalDigest])
  @@index([siteId, pageId, createdAt])
  @@index([repositoryId, createdAt])
  @@index([reviewJobId, createdAt])
  @@map("confluence_draft_artifacts")
}

model AuditEvent {
  id             String             @id @default(uuid()) @db.Uuid
  repositoryId   String             @map("repository_id") @db.Uuid
  reviewJobId    String?            @map("review_job_id") @db.Uuid
  eventType      String             @map("event_type")
  idempotencyKey String             @unique @map("idempotency_key")
  actorId        String?            @map("actor_id")
  details        Json
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  repository     RepositoryRegistry @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  reviewJob      ReviewJob?         @relation(fields: [reviewJobId], references: [id], onDelete: Restrict)

  @@index([repositoryId, createdAt])
  @@index([reviewJobId, createdAt])
  @@map("audit_events")
}
